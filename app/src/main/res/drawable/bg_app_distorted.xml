<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#050912"
                android:centerColor="#101827"
                android:endColor="#050912" />
        </shape>
    </item>
    <item android:gravity="top|start" android:top="0dp" android:left="0dp">
        <shape android:shape="oval">
            <size android:width="260dp" android:height="260dp" />
            <solid android:color="#247E22CE" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:bottom="0dp" android:right="0dp">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <solid android:color="#1E14A5E9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#68030712" />
        </shape>
    </item>
</layer-list>
