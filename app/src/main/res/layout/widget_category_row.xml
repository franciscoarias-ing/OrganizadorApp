<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCategoryRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widgetAppSlot1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_app_slot"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widgetAppIcon1"
            android:layout_width="28dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/widgetAppName1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetAppSlot2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_app_slot"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widgetAppIcon2"
            android:layout_width="28dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/widgetAppName2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetAppSlot3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_app_slot"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widgetAppIcon3"
            android:layout_width="28dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/widgetAppName3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetAppSlot4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_app_slot"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widgetAppIcon4"
            android:layout_width="28dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/widgetAppName4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
