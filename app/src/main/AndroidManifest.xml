<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrganizadorApps">


        <receiver
            android:name=".FixedCategoriesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fixed_categories_widget_info" />
        </receiver>

        <service
            android:name=".FixedCategoriesWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".WidgetAppLaunchReceiver"
            android:exported="false" />

        <activity
            android:name=".CategoryWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.OrganizadorApps" />

        <!-- Compact mode queda apagado por ahora: sigue declarado, pero ya no es launcher. -->
        <activity
            android:name=".CompactLauncherActivity"
            android:exported="false"
            android:theme="@style/Theme.OrganizadorApps.Transparent" />

        <!-- La app completa vuelve a ser la entrada principal. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OrganizadorApps">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
