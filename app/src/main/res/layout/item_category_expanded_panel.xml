<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expandedPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_category_expanded_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/expandedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <GridLayout
            android:id="@+id/expandedPreviewGrid"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:columnCount="2"
            android:rowCount="2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtExpandedCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#F4F7FB"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtExpandedCategoryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCollapseCategory"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_favorite_action_circle"
            android:contentDescription="Contraer categoría"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_up"
            android:tint="#C084FC" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPanelApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

</LinearLayout>